---
// Gráfico decorativo: una cotización ficticia ($SG) que fluye en directo
// y se deforma al pasar el ratón. No representa ningún dato real.
---

<figure class="chart" aria-hidden="true">
  <div class="chart-head">
    <span class="chart-sym">$SG</span>
    <span class="chart-quote"><span id="last">—</span><span id="chg" class="chg"></span></span>
  </div>
  <div class="chart-body">
    <svg class="line" viewBox="0 0 1000 240" preserveAspectRatio="none">
      <g class="grid">
        <line x1="0" x2="1000" y1="48" y2="48" />
        <line x1="0" x2="1000" y1="96" y2="96" />
        <line x1="0" x2="1000" y1="144" y2="144" />
        <line x1="0" x2="1000" y1="192" y2="192" />
      </g>
      <path class="area" id="area" />
      <path class="line-path" id="lp" />
    </svg>
    <div class="y-axis">
      <span style="top:20%">135</span>
      <span style="top:40%">125</span>
      <span style="top:60%">115</span>
      <span style="top:80%">105</span>
    </div>
  </div>
</figure>

<script>
  const svg = document.querySelector<SVGSVGElement>('.line');
  const line = document.getElementById('lp');
  const area = document.getElementById('area');
  const lastEl = document.getElementById('last');
  const chgEl = document.getElementById('chg');

  if (svg && line && area && lastEl && chgEl) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const W = 1000, H = 240, N = 72;
    const top = 24, bot = 216, range = bot - top;
    const sigma = W * 0.10, maxAmp = 70, speed = 0.06;

    const xs: number[] = [];
    for (let i = 0; i < N; i++) xs.push(i / (N - 1) * W);

    // PRNG con semilla fija
    let seed = 20260614;
    function rnd() {
      seed |= 0; seed = (seed + 0x6D2B79F5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    }

    // Camino aleatorio con reversión a la media → cotización
    let v = 0.5;
    function nextPrice() {
      v += (rnd() - 0.5) * 0.30;      // volatilidad (alta → se ve el movimiento)
      v += (0.5 - v) * 0.02;          // reversión suave a la media
      return Math.max(0.05, Math.min(0.95, v));
    }
    const priceToY = (p: number) => bot - p * range;
    const priceVal = (p: number) => 100 + p * 40;   // escala mostrada en el eje

    // Buffer de precios (uno más para interpolar el desplazamiento)
    const buf: number[] = [];
    for (let i = 0; i < N + 1; i++) buf.push(nextPrice());

    const bump = new Array(N).fill(0);
    let frac = 0, mx: number | null = null, my = H / 2, tick = 0;

    function build() {
      let d = '';
      for (let i = 0; i < N; i++) {
        const base = priceToY(buf[i] + (buf[i + 1] - buf[i]) * frac);
        const y = base + bump[i];
        d += (i ? ' L' : 'M') + xs[i].toFixed(1) + ',' + y.toFixed(1);
      }
      line!.setAttribute('d', d);
      area!.setAttribute('d', d + ' L' + W + ',' + H + ' L0,' + H + ' Z');
    }

    function quote() {
      const last = priceVal(buf[N - 1] + (buf[N] - buf[N - 1]) * frac);
      const first = priceVal(buf[0] + (buf[1] - buf[0]) * frac);
      const chg = (last - first) / first * 100;
      lastEl!.textContent = last.toFixed(2);
      chgEl!.textContent = (chg >= 0 ? '▲ +' : '▼ ') + chg.toFixed(2) + '%';
      chgEl!.className = 'chg ' + (chg >= 0 ? 'up' : 'down');
    }

    if (reduce) {
      build();
      quote();
    } else {
      window.addEventListener('mousemove', (e) => {
        const r = svg.getBoundingClientRect();
        mx = (e.clientX - r.left) / r.width * W;
        const yy = (e.clientY - r.top) / r.height * H;
        my = H / 2 + Math.max(-maxAmp, Math.min(maxAmp, yy - H / 2));
      }, { passive: true });
      window.addEventListener('mouseleave', () => { mx = null; });

      const frame = () => {
        // streaming: desplaza el gráfico a la izquierda
        frac += speed;
        while (frac >= 1) { frac -= 1; buf.shift(); buf.push(nextPrice()); }

        // empuje del ratón (gaussiano, con muelle)
        for (let i = 0; i < N; i++) {
          let target = 0;
          if (mx !== null) {
            const dx = xs[i] - mx;
            target = (my - H / 2) * Math.exp(-(dx * dx) / (2 * sigma * sigma));
          }
          bump[i] += (target - bump[i]) * 0.16;
        }

        build();
        if ((tick++ % 10) === 0) quote();
        requestAnimationFrame(frame);
      };
      frame();
    }
  }
</script>
